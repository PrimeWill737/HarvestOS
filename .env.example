# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Actual Supabase Session Pooler URL, normally port 5432; URL-encode password.
DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_MAX=2
# Only used by the one-time bootstrap command, never browser code.
BOOTSTRAP_ADMIN_EMAIL=
# Optional private media integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_BYTES=5242880
# Optional notification delivery
RESEND_API_KEY=
NOTIFICATION_FROM=HarvestOS <notifications@example.com>
OUTBOX_MAX_ATTEMPTS=5
# Worker token for protected scheduled endpoint
CRON_SECRET=
# Operational settings
APP_ENV=development
DEFAULT_REGION=Plateau
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos
RATE_LIMIT_PER_MINUTE=60
# Optional error reporting (server only)
SENTRY_DSN=

# Optional MapLibre style from a licensed/compliant tile provider.
NEXT_PUBLIC_MAP_STYLE_URL=
MAP_ALLOWED_ORIGINS=
